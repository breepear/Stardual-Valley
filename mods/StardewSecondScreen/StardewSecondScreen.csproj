<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>StardewDualScreen</AssemblyName>
    <RootNamespace>StardewSecondScreen</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableHarmony>false</EnableHarmony>
    <!--
      The game runs on the Thor (Android storage or Cinderbox), not on the machine
      that builds this, so the mod is copied over by hand. Set GamePath to a PC
      Stardew Valley install with SMAPI if the build can't find one on its own.
    -->
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

</Project>
